          "type": "item_2",
          "settings": {
            "text_1": "How long does shipping take?",
            "copy_2": "Most orders within India dispatch within 48 hours and arrive in 3–6 working days. International orders take 7–10 working days after dispatch. Tracking is shared the moment the parcel leaves the studio."
          }
        },
        "item_3": {
          "type": "item_3",
          "settings": {
            "text_1": "Can I return or exchange a piece?",
            "copy_2": "Yes — exchanges are free within 7 days of delivery, provided the piece is unworn with tags intact. Refunds are processed within 5–7 working days of us receiving the return. Sale items are eligible for exchanges only."
          }
        },
        "item_4": {
          "type": "item_4",
          "settings": {
            "text_1": "Do you take wholesale or bulk orders?",
            "copy_2": "We work with a small number of boutiques and studios across India. Please write to hello@krithiweaves.com with \"Wholesale\" in the subject and we will share our line-sheet within two working days."
          }
        },
        "item_5": {
          "type": "item_5",
          "settings": {
            "text_1": "How should I care for the fabric?",
            "copy_2": "Machine wash cold, inside out, with a mild detergent. Line dry in shade. Do not wring or tumble dry. A quick steam-iron on low keeps the weave looking crisp without compromising softness."
          }
        }

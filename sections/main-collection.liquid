<div data-error-message="{{ section.settings.error_message | escape }}" data-collection-section="{{ section.id }}"><section class="section pt-8 pb-3 md:pt-12 md:pb-6"><nav class="mb-5 flex items-center gap-1.5 text-[11px] uppercase tracking-[0.2em] text-strong-coffee/65 sm:text-xs"><a href="{{ routes.root_url }}">{{ section.settings.home_label }}</a> › <span class="text-rust">{{ section.settings.overline }}</span></nav><h1 data-animated-text class="font-libre-baskerville text-3xl text-dark-chocolate sm:text-4xl md:text-5xl">{{ section.settings.title }}</h1><p class="mt-3 max-w-2xl text-sm text-strong-coffee/80 sm:text-base">{{ section.settings.description }}</p><span class="mt-6 block h-px w-full bg-linear-to-r from-rust/0 via-rust/40 to-rust/0"></span></section><section class="section pb-14 md:pb-20"><div class="grid grid-cols-1 gap-6 lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-8 xl:grid-cols-[280px_minmax(0,1fr)]"><div class="hidden lg:block"><div class="sticky top-24 flex max-h-[calc(100vh-7rem)] flex-col">{% render 'collection-filters', section: section %}</div></div><div class="flex flex-col gap-5"><div class="flex items-center justify-between gap-3 border-b border-strong-coffee/10 pb-3"><div class="flex items-center gap-3"><button type="button" data-open-modal="collection-filters" class="inline-flex items-center gap-2 rounded-full border border-strong-coffee/20 bg-white px-4 py-2 text-xs text-strong-coffee/85 lg:hidden">{% render 'icon', name: 'filter' %} {{ section.settings.filters_label }}</button><span class="text-[12px] text-strong-coffee/60 sm:text-[13px]"><strong class="text-dark-chocolate">{{ collection.products_count }}</strong> {{ section.settings.products_label }}</span></div><form class="relative" action="{{ collection.url }}"><select data-sort name="sort_by" aria-label="{{ section.settings.sort_label }}" class="appearance-none rounded-full border border-strong-coffee/20 bg-white py-2 pl-4 pr-9 text-[12px] text-strong-coffee/85 outline-none sm:text-[13px]">{% assign sort_values = 'best-selling,created-descending,price-ascending,price-descending' | split: ',' %}{% assign current_sort = collection.sort_by | default: 'best-selling' %}{% for value in sort_values %}{% assign key = 'sort_' | append: forloop.index %}<option value="{{ value }}" {% if current_sort == value %}selected{% endif %}>{{ section.settings.sort_label }}: {{ section.settings[key] }}</option>{% endfor %}</select><span aria-hidden="true" class="pointer-events-none absolute right-3 top-2 text-xl text-rust">{% render 'icon', name: 'caret-down' %}</span><noscript><button>{{ section.settings.apply_label }}</button></noscript></form></div><p data-commerce-error role="alert" class="text-xs text-red-600"></p>{% paginate collection.products by 100 %}{% if collection.products_count > 0 %}{% render 'product-grid', products: collection.products %}{% else %}<div class="flex flex-col items-center justify-center px-4 py-16 text-center md:py-24">{% render 'empty-loom' %}<h3 data-animated-text class="font-libre-baskerville text-2xl text-dark-chocolate sm:text-3xl md:text-4xl">{{ section.settings.empty_title }}</h3><p class="mt-4 max-w-md text-sm text-strong-coffee/75 sm:text-base">{{ section.settings.empty_text }}</p><a data-collection-link href="{{ collection.url }}" class="mt-7 rounded-full border border-rust px-6 py-2.5 text-xs uppercase tracking-[0.2em] text-rust">{{ section.settings.clear_label }}</a></div>{% endif %}{% if paginate.pages > 1 %}<nav data-pagination class="flex justify-center gap-4">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</div></div></section><div data-modal="collection-filters" data-modal-variant="bottom" hidden><div data-modal-panel><div class="flex justify-between px-5 py-4"><h2 class="font-libre-baskerville text-base text-dark-chocolate">{{ section.settings.filters_label }}</h2><button data-close-modal aria-label="{{ section.settings.close_label }}">{% render 'icon', name: 'close' %}</button></div>{% render 'collection-filters', section: section, hide_heading: true %}</div></div></div>
{% schema %}

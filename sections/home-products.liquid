{% liquid
  assign selected_collection = section.settings.collection
  if selected_collection == blank
    if section.settings.mode == 'best'
      assign selected_collection = collections['best-sellers']
    else
      assign selected_collection = collections['featured']
    endif
  endif
  if section.settings.mode == 'best'
    assign products = section.settings.best_seller_products
  else
    assign products = section.settings.products
  endif
  if products == blank
    assign products = selected_collection.products
  endif
  assign destination = section.settings.link | default: routes.all_products_collection_url
%}
<section class="section {% if section.settings.mode == 'best' %}pb-10 md:pb-14{% else %}py-10 md:py-14{% endif %}" aria-label="{{ section.settings.heading | escape }}">
  <div class="mb-6 flex items-center justify-between gap-4 md:mb-8" data-motion='{"initial":{"opacity":0,"y":12},"animate":{"opacity":1,"y":0},"transition":{"duration":0.55,"ease":[0.22,1,0.36,1]},"inView":true,"viewport":{"amount":0.2}}'>
    <div><h2 class="font-libre-baskerville text-2xl text-dark-chocolate sm:text-3xl">{{ section.settings.heading | escape }}</h2><span class="mt-2 block h-0.5 w-12 bg-rust"></span></div>
    <a href="{{ destination }}" class="group inline-flex shrink-0 items-center gap-1 pb-1 text-xs text-rust transition-colors sm:text-sm -translate-y-1"><span>{{ section.settings.link_label | escape }}</span><span aria-hidden="true" class="inline-flex transition-transform duration-200 ease-out group-hover:translate-x-0.5">{% render 'icon', name: 'chevron-right' %}</span></a>
  </div>
  {% if products != blank %}
    {% if section.settings.mode == 'best' %}
      <div class="grid grid-cols-2 gap-3 sm:hidden">
        {% for product in products limit: 3 %}
          <div class="{% if forloop.first %}col-span-2{% endif %}" data-motion='{"initial":{"opacity":0,"y":14},"animate":{"opacity":1,"y":0},"transition":{"duration":0.4,"delay":{{ forloop.index0 | times: 0.04 | plus: 0.02 }},"ease":[0.22,1,0.36,1]},"inView":true,"viewport":{"amount":0.25}}'>{% render 'product-card', product: product, mode: 'mobile-best', index: forloop.index0 %}</div>
        {% endfor %}
      </div>
      <div class="hidden gap-5 sm:grid sm:grid-cols-2 md:grid-cols-3">
        {% for product in products limit: 3 %}<div data-motion='{"initial":{"opacity":0,"y":14},"animate":{"opacity":1,"y":0},"transition":{"duration":0.4,"delay":{{ forloop.index0 | times: 0.04 | plus: 0.02 }},"ease":[0.22,1,0.36,1]},"inView":true,"viewport":{"amount":0.3}}'>{% render 'product-card', product: product, mode: 'best', index: forloop.index0 %}</div>{% endfor %}
      </div>
    {% else %}
      <div class="relative sm:hidden" data-carousel>
        <div class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto scroll-smooth gap-3 py-2" data-carousel-track>
          {% for product in products limit: 6 %}<div class="shrink-0 snap-start basis-[70%]" data-motion='{"initial":{"opacity":0,"y":14},"animate":{"opacity":1,"y":0},"transition":{"duration":0.4,"delay":{{ forloop.index0 | times: 0.04 | plus: 0.02 }},"ease":[0.22,1,0.36,1]},"inView":true,"viewport":{"amount":0.2}}'>{% render 'product-card', product: product, mode: 'mobile', index: forloop.index0 %}</div>{% endfor %}
        </div>
      </div>
      <div class="relative hidden sm:block" data-carousel>
        <div class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto scroll-smooth gap-4 md:gap-5 py-2" data-carousel-track>
          {% for product in products limit: 6 %}<div class="shrink-0 snap-start basis-[70%] sm:basis-[45%] md:basis-[33%] lg:basis-[25%]" data-motion='{"initial":{"opacity":0,"y":14},"animate":{"opacity":1,"y":0},"transition":{"duration":0.4,"delay":{{ forloop.index0 | times: 0.04 | plus: 0.02 }},"ease":[0.22,1,0.36,1]},"inView":true,"viewport":{"amount":0.2}}'>{% render 'product-card', product: product, mode: 'desktop', index: forloop.index0 %}</div>{% endfor %}
        </div>
        <button type="button" data-carousel-prev class="absolute left-0 top-1/2 z-30 hidden size-10 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-rust shadow-md md:grid" aria-label="{{ section.settings.previous | escape }}">{% render 'icon', name: 'chevron-left' %}</button>
        <button type="button" data-carousel-next class="absolute right-0 top-1/2 z-30 hidden size-10 -translate-y-1/2 place-items-center rounded-full bg-rust text-white shadow-md md:grid" aria-label="{{ section.settings.next | escape }}">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    {% endif %}
  {% else %}<p class="py-8 text-center text-strong-coffee/70">{{ section.settings.empty | escape }}</p>{% endif %}
</section>
{% schema %}
{
  "name": "Product collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Collection presentation",
      "options": [
        {
          "value": "featured",
          "label": "Featured products"
        },
        {
          "value": "best",
          "label": "Best sellers"
        }
      ],
      "default": "featured"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Featured product selection (overrides collection)",
      "limit": 12
    },
    {
      "type": "product_list",
      "id": "best_seller_products",
      "label": "Best-seller product selection (overrides collection)",
      "limit": 3
    },
    {
      "type": "url",
      "id": "link",
      "label": "View all destination"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View all label",
      "default": "View All"
    },
    {
      "type": "text",
      "id": "empty",
      "label": "Empty collection message",
      "default": "Our collection is coming soon."
    },
    {
      "type": "text",
      "id": "previous",
      "label": "Previous products label",
      "default": "Scroll left"
    },
    {
      "type": "text",
      "id": "next",
      "label": "Next products label",
      "default": "Scroll right"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    },
    {
      "name": "Best sellers",
      "settings": {
        "mode": "best",
        "heading": "Best Sellers"
      }
    }
  ]
}
{% endschema %}

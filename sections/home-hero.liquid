ro-review-badge', section: section, visibility: 'inline-flex sm:hidden' %}{% endif %}</div><ul class="mt-1 flex w-full items-center justify-start gap-4 whitespace-nowrap text-xs text-white sm:hidden">{% for block in section.blocks %}{% case block.type %}{% when 'item_3' %}<li data-editor-block="{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text_1 | default: '• Free Shipping' | escape }}</li>

    },
    {
      "type": "item_2",
      "name": "Fit notes on products",
      "settings": [
        {
          "type": "text",
          "id": "text_1",
          "label": "Section Title",
          "default": "Fit notes on products"
        },
        {
          "type": "textarea",
          "id": "copy_2",
          "label": "Body Copy",

ation&quot;:0.35,&quot;ease&quot;:[0.22,1,0.36,1],&quot;delay&quot;:0.2}},&quot;transition&quot;:{&quot;duration&quot;:0.35,&quot;ease&quot;:[0.22,1,0.36,1],&quot;delay&quot;:0.2},&quot;inView&quot;:true,&quot;viewport&quot;:{&quot;once&quot;:true,&quot;amount&quot;:0.25}}">{{ section.settings.copy_4 | default: 'We don&#39;t own factories — we partner with them. Five small, women-led ateliers across Karnataka and Tamil Nadu stitch every Krithi piece. Each partner is audited every six months for fair wages, safe conditions, and transparent ownership.' | escape }}</p></div><div class="relative mx-auto aspect-[4/5] w-full max-w-[380px] overflow-hidden rounded-[22px] md:mx-0" data-motion="{&quot;initial&quot;:{&quot;opacity&quot;:0,&quot;y&quot;:10},&quot;animate&quot;:{&quot;opacity&quot;:1,&quot;y&quot;:0,&quot;transition&quot;:{&quot;duration&quot;:0.35,&quot;ease&quot;:[0.22,1,0.36,1]}},&quot;transition&quot;:{&quot;duration&quot;:0.35,&quot;ease&quot;:[0.22,1,0.36,1]},&quot;inView&quot;:true,&quot;viewport&quot;:{&quot;once&quot;:true,&quot;amount&quot;:0.25}}"><img alt="{{ section.settings.text_6 | default: 'Tailor working at one of Krithi Weaves partner ateliers' | escape }}" sizes="(max-width: 768px) 90vw, 380px" class="object-cover" src="{% if section.settings.image_5 != blank %}{{ section.settings.image_5 | image_url: width: 2000 }}{% else %}{{ 'how.jpg' | asset_url }}{% endif %}" width="1333" height="2000" loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%" data-image-fade="450"></div></div></section>

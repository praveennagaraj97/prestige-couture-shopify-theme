{% assign selected = product.selected_or_first_available_variant %}<section data-product-section data-product-id="{{ product.id }}" data-currency="{{ cart.currency.iso_code }}" class="section py-5 md:py-7 lg:py-8"><script type="application/json" data-variants>[{% for variant in product.variants %}{"id":{{ variant.id }},"title":{{ variant.title | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"compare_at_price":{{ variant.compare_at_price | default: 0 }},"image":{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1600 | json }}{% else %}null{% endif %},"max":{% if variant.inventory_management and variant.inventory_policy == 'deny' %}{{ variant.inventory_quantity | at_least: 0 }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>
<div class="grid grid-cols-1 gap-7 lg:grid-cols-[minmax(0,1.02fr)_minmax(0,0.98fr)] lg:items-start lg:gap-8 xl:gap-10"><div data-gallery class="lg:sticky lg:top-22 lg:h-[calc(100svh-10rem)]"><div class="relative md:hidden"><div data-gallery-track class="flex snap-x snap-mandatory overflow-x-auto gap-0 no-scrollbar">{% for image in product.images %}<button data-gallery-open="{{ forloop.index0 }}" type="button" class="relative aspect-3/4 w-full shrink-0 snap-start overflow-hidden rounded-2xl bg-white-chocolate" aria-label="{{ section.settings.zoom_label }} {{ image.alt | default: product.title | escape }}">{{ image | image_url: width: 1200 | image_tag: class: 'absolute inset-0 h-full w-full object-contain object-center', sizes: '100vw' }}</button>{% endfor %}</div><span data-gallery-counter class="pointer-events-none absolute left-4 top-4 rounded-full bg-white/85 px-3 py-1 text-[11px]">01 / {{ product.images.size }}</span></div><div class="hidden md:flex md:h-full md:min-h-0 md:flex-row-reverse md:items-stretch md:gap-4"><div class="group/main relative aspect-3/4 w-full overflow-hidden rounded-2xl bg-white-chocolate md:aspect-auto md:flex-1 md:min-h-0 md:h-full"><button type="button" data-gallery-open class="absolute inset-0 cursor-zoom-in" aria-label="{{ section.settings.zoom_label }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1600 | image_tag: class: 'h-full w-full object-contain object-center', id: 'ProductMainImage' }}{% endif %}</button><span data-gallery-counter class="pointer-events-none absolute left-4 top-4 rounded-full bg-white/85 px-3 py-1 text-[11px]">01 / {{ product.images.size }}</span><button type="button" data-gallery-open aria-label="{{ section.settings.zoom_label }}" class="absolute right-4 top-4 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/85 text-dark-chocolate">{% render 'icon', name: 'expand' %}</button>{% if product.images.size > 1 %}<button type="button" data-gallery-step="-1" aria-label="{{ section.settings.previous_label }}" class="absolute left-3 top-1/2 h-10 w-10 rounded-full bg-white/85 opacity-0 group-hover/main:opacity-100">{% render 'icon', name: 'chevron-left' %}</button><button type="button" data-gallery-step="1" aria-label="{{ section.settings.next_label }}" class="absolute right-3 top-1/2 h-10 w-10 rounded-full bg-white/85 opacity-0 group-hover/main:opacity-100">{% render 'icon', name: 'chevron-right' %}</button>{% endif %}</div><div class="flex gap-2 overflow-x-auto overflow-y-visible no-scrollbar px-0.5 py-1 md:h-full md:w-20 md:min-h-0 md:shrink-0 md:flex-col md:overflow-x-visible md:overflow-y-auto md:py-0 md:pr-1 md:thumb-scroll md:max-h-full">{% for image in product.images %}<button data-motion='{"initial":{"opacity":0,"y":12},"animate":{"opacity":1,"y":0},"transition":{"duration":0.25,"ease":[0.22,1,0.36,1],"delay":{{ forloop.index0 | times: 0.04 | plus: 0.1 }}}' data-gallery-thumb="{{ forloop.index0 }}" data-image="{{ image | image_url: width: 1600 }}" data-alt="{{ image.alt | default: product.title | escape }}" type="button" aria-label="{{ section.settings.view_label }} {{ forloop.index }}" class="relative aspect-3/4 w-16 max-w-full shrink-0 overflow-hidden rounded-lg bg-white-chocolate transition md:w-full outline-1 outline-strong-coffee/15">{{ image | image_url: width: 160 | image_tag: class: 'h-full w-full object-cover', loading: 'lazy' }}</button>{% endfor %}</div></div></div>
<div class="flex flex-col gap-6"><div data-motion='{"initial":{"opacity":0,"y":12},"animate":{"opacity":1,"y":0},"transition":{"duration":0.35,"ease":[0.22,1,0.36,1]}}' class="flex flex-col gap-5"><div><p class="mb-2 text-[11px] uppercase tracking-[0.25em] text-rust">{{ product.type | default: section.settings.product_label }}</p><h1 data-animated-text class="font-libre-baskerville text-3xl text-dark-chocolate md:text-4xl">{{ product.title | escape }}</h1>{% if product.metafields.custom.number_of_reviews.value > 0 %}<div class="mt-3 flex items-center gap-2 text-xs text-strong-coffee/70"><span class="text-rust">★★★★★</span><span>{{ product.metafields.custom.review.value.rating | default: product.metafields.custom.review.value }}</span> · {{ product.metafields.custom.number_of_reviews.value }} {{ section.settings.reviews_label }}</div>{% endif %}</div><div data-motion='{"initial":{"opacity":0,"y":8},"animate":{"opacity":1,"y":0},"transition":{"duration":0.25,"delay":0.15}}' class="flex items-baseline gap-3"><span data-product-price class="font-libre-baskerville text-3xl text-dark-chocolate md:text-4xl">{{ selected.price | money }}</span><s data-product-compare {% unless selected.compare_at_price > selected.price %}hidden{% endunless %} class="text-base text-strong-coffee/55">{{ selected.compare_at_price | money }}</s><span data-product-discount data-save-label="{{ section.settings.save_label }}" class="rounded-full bg-rust/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.15em] text-rust"></span></div><div class="flex flex-wrap justify-start gap-2 self-start text-left">{% for tag in product.tags %}<span class="rounded-full border border-rust/20 bg-white px-3 py-1 text-xs font-medium uppercase tracking-[0.16em] text-strong-coffee/75">{{ tag | escape }}</span>{% endfor %}</div><span class="block h-px w-full bg-linear-to-r from-rust/0 via-rust/40 to-rust/0"></span><div class="text-sm leading-relaxed text-strong-coffee/85 md:text-base">{{ product.description }}</div></div>
{% form 'product', product, data-product-form: '', class: 'flex flex-col gap-5' %}<div><div class="mb-3 flex items-center justify-between"><h3 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-dark-chocolate">{{ section.settings.size_label }} · <span data-variant-title>{{ selected.title | escape }}</span></h3><button type="button" data-open-modal="size-guide" class="inline-flex items-center gap-1.5 text-xs font-medium text-strong-coffee/75">{{ section.settings.guide_label }}</button></div><noscript><style>[data-variant-select]{position:static!important;width:auto!important;height:auto!important;clip:auto!important;clip-path:none!important}</style></noscript><select name="id" data-variant-select class="sr-only" aria-label="{{ section.settings.size_label }}">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if selected.id == variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }}</option>{% endfor %}</select><div class="flex flex-wrap gap-2">{% for variant in product.variants %}<button data-motion='{"initial":{"opacity":0,"y":10,"scale":0.85},"animate":{"opacity":1,"y":0,"scale":1},"transition":{"type":"spring","stiffness":320,"damping":20}}' type="button" data-variant-id="{{ variant.id }}" aria-pressed="{% if selected.id == variant.id %}true{% else %}false{% endif %}" {% unless variant.available %}disabled{% endunless %} class="relative inline-flex min-w-12 items-center justify-center rounded-full border px-4 py-2.5 text-sm font-medium tracking-wide transition {% if selected.id == variant.id %}border-rust bg-rust text-white{% else %}border-strong-coffee/20 text-strong-coffee{% endif %} disabled:line-through disabled:opacity-35">{{ variant.title | escape }}</button>{% endfor %}</div><p data-stock data-stock-template="{{ section.settings.stock_text | escape }}" class="mt-2 text-xs font-medium text-amber-600"></p></div><div data-motion='{"initial":{"opacity":0,"y":16},"animate":{"opacity":1,"y":0},"transition":{"duration":0.55,"ease":[0.22,1,0.36,1],"delay":0.35}}' class="flex flex-col gap-3"><div data-product-quantity class="flex items-center gap-3"><label for="Quantity-{{ section.id }}" class="text-[11px] font-semibold uppercase tracking-[0.22em] text-dark-chocolate">{{ section.settings.quantity_label }}</label><div class="inline-flex items-center rounded-full border border-strong-coffee/20 bg-white"><button type="button" data-product-delta="-1" aria-label="{{ section.settings.decrease_label }}" class="inline-flex h-10 w-10 items-center justify-center">−</button><input id="Quantity-{{ section.id }}" name="quantity" type="number" min="1" value="1" class="w-8 bg-transparent text-center text-sm font-semibold text-dark-chocolate tabular-nums"><button type="button" data-product-delta="1" aria-label="{{ section.settings.increase_label }}" class="inline-flex h-10 w-10 items-center justify-center">+</button></div></div><div class="grid grid-cols-1 gap-2 sm:grid-cols-2"><button type="submit" data-product-add data-add-label="{{ section.settings.add_label }}" data-in-label="{{ section.settings.in_label }}" data-added-label="{{ section.settings.added_label }}" data-adding-label="{{ section.settings.adding_label }}" {% unless selected.available %}disabled{% endunless %} class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-rust bg-white px-5 py-3.5 text-sm font-semibold tracking-wide text-rust disabled:opacity-50">{{ section.settings.add_label }}</button><button type="submit" name="buy_now" data-product-buy data-buy-label="{{ section.settings.buy_label }}" data-checkout-label="{{ section.settings.checkout_label }}" {% unless selected.available %}disabled{% endunless %} class="inline-flex items-center justify-center gap-2 rounded-full bg-rust px-5 py-3.5 text-sm font-semibold tracking-wide text-white shadow-md disabled:opacity-50">{{ section.settings.buy_label }}</button></div><p data-sold-out {% if selected.available %}hidden{% endif %} class="text-xs text-red-600">{{ section.settings.sold_out_text }}</p><p data-commerce-error role="alert" class="text-xs text-red-600"></p></div>{% endform %}
<ul class="grid grid-cols-2 gap-y-4 gap-x-5 rounded-2xl bg-white-chocolate/50 px-4 py-4 sm:grid-cols-4 sm:gap-x-2">{% assign promise_blocks = section.blocks | where: 'type', 'promise' %}{% for block in promise_blocks %}<li class="flex items-center gap-3 sm:flex-col sm:items-center sm:text-center {% unless forloop.first %}sm:border-l sm:border-rust/15{% endunless %}"><span class="inline-flex h-8 w-8 items-center justify-center text-rust">{% render 'icon', name: block.settings.icon %}</span><div><p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-dark-chocolate leading-tight">{{ block.settings.title }}</p><p class="mt-0.5 text-[11px] text-strong-coffee/60 leading-snug">{{ block.settings.text }}</p></div></li>{% endfor %}</ul><div class="divide-y divide-strong-coffee/10 rounded-2xl border border-strong-coffee/10 bg-white"><details open data-product-details><summary class="flex w-full items-center justify-between gap-3 px-5 py-4 font-libre-baskerville text-base text-dark-chocolate">{{ section.settings.details_label }} <span>⌄</span></summary><div class="px-5 pb-5 text-sm leading-relaxed text-strong-coffee/85">{% if product.metafields.custom.details != blank %}{{ product.metafields.custom.details | metafield_tag }}{% else %}{{ product.description }}{% endif %}{% if product.metafields.custom.colour != blank %}<p>{{ section.settings.colour_label }}: {{ product.metafields.custom.colour.value }}</p>{% endif %}</div></details><details data-product-details><summary class="flex w-full items-center justify-between gap-3 px-5 py-4 font-libre-baskerville text-base text-dark-chocolate">{{ section.settings.care_label }} <span>⌄</span></summary><div class="px-5 pb-5 text-sm text-strong-coffee/80">{{ product.metafields.custom.fabric_care | metafield_tag }}</div></details><details data-product-details><summary class="flex w-full items-center justify-between gap-3 px-5 py-4 font-libre-baskerville text-base text-dark-chocolate">{{ section.settings.shipping_label }} <span>⌄</span></summary><div class="px-5 pb-5 space-y-3 text-sm text-strong-coffee/80">{{ section.settings.shipping_text }}</div></details></div></div></div>
{% render 'product-size-guide', section: section %}{% render 'product-lightbox', section: section, product: product %}</section>

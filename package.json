{
  "name": "krithi-weaves-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i assets/base.css -o assets/theme.css --minify",
    "build:js": "esbuild src/theme.js --bundle --minify --format=esm --target=es2020 --outfile=assets/theme.js",
    "build": "npm run build:css && npm run build:js",
    "check:css": "node scripts/check-css.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run check:css && shopify theme check",
    "package": "bash scripts/package-theme.sh",
    "dev": "concurrently --kill-others --handle-input --default-input-target 2 --names css,js,shopify \"npm:dev:css\" \"npm:dev:js\" \"npm:dev:shopify\"",
    "dev:css": "tailwindcss -i assets/base.css -o assets/theme.css --watch=always",
    "dev:js": "esbuild src/theme.js --bundle --format=esm --target=es2020 --outfile=assets/theme.js --watch=forever",
    "dev:shopify": "if [ -n \"${THEME:-}\" ]; then \"${SHOPIFY:-shopify}\" theme dev --store \"${STORE:-b8pvud-pu.myshopify.com}\" --theme \"$THEME\" --port \"${PORT:-9292}\"; else \"${SHOPIFY:-shopify}\" theme dev --store \"${STORE:-b8pvud-pu.myshopify.com}\" --port \"${PORT:-9292}\"; fi"
  },
  "dependencies": {
    "motion": "12.38.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "cheerio": "1.1.2",
    "concurrently": "^9.2.1",
    "esbuild": "0.25.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.3.3"
  }
}

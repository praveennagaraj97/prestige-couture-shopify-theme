{%- liquid
  assign mode = mode | default: 'desktop'
  assign variant = product.first_available_variant | default: product.variants.first
  assign mobile = false
  if mode == 'mobile' or mode == 'mobile-best'
    assign mobile = true
  endif
  assign best = false
  if mode == 'best' or mode == 'mobile-best'
    assign best = true
  endif
  assign in_cart = false
  for item in cart.items
    if item.product_id == product.id
      assign in_cart = true
    endif
  endfor
  assign discount = 0
  if variant.compare_at_price > variant.price
    assign discount = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
  endif
-%}
<article data-product-card data-product-id="{{ product.id }}" class="{% if mode == 'mobile' %}flex h-full flex-col overflow-hidden rounded-3xl border border-dark-chocolate/12 bg-white shadow-[0_8px_28px_-20px_rgba(82,29,23,0.32)]{% elsif mode == 'mobile-best' %}overflow-hidden rounded-3xl border border-dark-chocolate/10 bg-white shadow-[0_8px_26px_-20px_rgba(82,29,23,0.28)]{% else %}group relative flex w-full flex-col{% endif %} {{ class }}">
  <div class="relative">
  <a href="{{ product.url }}" draggable="false" class="{% if mode == 'mobile' %}relative block aspect-[0.92] overflow-hidden bg-white-chocolate/60{% elsif mode == 'mobile-best' %}relative block h-70 overflow-hidden bg-white-chocolate/55{% else %}group/card relative block {% if best %}aspect-square{% else %}aspect-3/4{% endif %} w-full overflow-hidden rounded-xl bg-white-chocolate focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rust/40{% endif %}">
    <img src="{{ 'product_card_bg.png' | asset_url }}" width="600" height="800" alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy">
    {% if mobile %}{% assign image_class = 'absolute inset-0 z-10 h-full w-full object-cover object-top' %}{% else %}{% assign image_class = 'absolute inset-0 z-10 h-full w-full object-contain object-center transition-transform duration-700 group-hover:scale-105' %}{% endif %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: class: image_class, loading: 'lazy', widths: '300,450,600,900', sizes: '(max-width: 639px) 50vw, 30vw' }}{% endif %}
    {% unless mobile %}<span data-card-badge {% unless in_cart %}hidden{% endunless %} class="absolute left-3 top-3 z-20 inline-flex items-center gap-1 rounded-full bg-dark-chocolate/75 backdrop-blur-sm px-2.5 py-1 text-[10px] font-medium text-white">{% render 'icon', name: 'check' %} {{ settings.card_in_cart_label }}</span>{% endunless %}
    {% if discount > 0 %}<span data-card-discount {% if in_cart and mobile == false %}hidden{% endif %} class="absolute left-3 top-3 z-20 rounded-full bg-red-500 px-2.5 py-1 text-xs font-medium text-white shadow-sm">-{{ discount }}%</span>{% endif %}
    {% if mode == 'best' %}<div class="absolute inset-x-0 bottom-0 z-20 bg-linear-to-t from-black/80 via-black/40 to-transparent px-4 pb-4 pt-12"><h3 class="line-clamp-1 text-center text-sm font-medium text-white sm:text-base">{{ product.title | escape }}</h3></div>{% endif %}
  </a>
  {% unless mobile %}<form action="{{ routes.cart_add_url }}" method="post" data-card-form data-product-id="{{ product.id }}" class="pointer-events-none absolute inset-x-0 bottom-0 z-30 flex justify-center {% if best %}pb-14{% else %}pb-4{% endif %} opacity-0 translate-y-2 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:opacity-100"><input type="hidden" name="id" value="{{ variant.id }}"><button type="submit" data-card-action data-in-cart="{{ in_cart }}" data-available="{{ variant.available }}" data-add-label="{{ settings.card_add_label | escape }}" data-view-label="{{ settings.card_view_label | escape }}" data-adding-label="{{ settings.card_adding_label | escape }}" {% unless variant.available %}disabled{% endunless %} class="pointer-events-auto inline-flex {% if best %}items-center gap-1.5 rounded-full bg-white/90 px-4 py-2 text-xs font-medium text-rust shadow backdrop-blur-sm transition hover:bg-white disabled:opacity-70{% else %}w-[75%] items-center justify-center gap-2 rounded-full bg-rust px-5 py-3 text-sm font-medium text-white shadow-md disabled:opacity-80{% endif %}">{% render 'icon', name: 'bag' %}<span data-card-label>{% if in_cart %}{{ settings.card_view_label }}{% else %}{{ settings.card_add_label }}{% endif %}</span></button></form>{% endunless %}
  </div>
  {% unless mode == 'best' %}<div class="{% if mode == 'mobile' %}flex flex-1 flex-col px-2 pb-3 pt-2{% elsif mode == 'mobile-best' %}flex items-center justify-center p-3 text-center{% else %}mt-3 flex flex-col gap-1{% endif %}"><a href="{{ product.url }}" tabindex="-1"><h3 class="{% if mode == 'mobile-best' %}line-clamp-2 text-dark-chocolate font-medium{% elsif mobile %}line-clamp-1 text-sm leading-5 text-dark-chocolate{% else %}line-clamp-1 text-sm font-medium text-strong-coffee sm:text-base{% endif %}">{{ product.title | escape }}</h3></a>
  {% unless best %}<div class="{% if mobile %}mt-2{% endif %} flex items-baseline gap-2 text-sm"><span class="{% if mobile %}text-[18px] leading-none{% endif %} font-semibold text-dark-chocolate">{{ variant.price | money }}</span>{% if discount > 0 %}<s class="text-xs text-strong-coffee/60">{{ variant.compare_at_price | money }}</s>{% endif %}</div>{% if mobile %}<div class="mt-1"><span class="text-xs font-medium leading-none text-rust {% if discount == 0 %}invisible{% endif %}">{{ discount }}% {{ settings.card_off_label }}</span></div><form action="{{ routes.cart_add_url }}" method="post" data-card-form data-product-id="{{ product.id }}" class="mt-auto"><input type="hidden" name="id" value="{{ variant.id }}"><button data-card-action data-in-cart="{{ in_cart }}" data-available="{{ variant.available }}" data-add-label="{{ settings.card_mobile_add_label | escape }}" data-view-label="{{ settings.card_mobile_view_label | escape }}" data-adding-label="{{ settings.card_adding_label | escape }}" {% unless variant.available %}disabled{% endunless %} class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-full bg-rust px-4 py-2 text-sm font-medium text-white"><span data-card-label>{% if in_cart %}{{ settings.card_mobile_view_label }}{% else %}{{ settings.card_mobile_add_label }}{% endif %}</span>{% render 'icon', name: 'bag' %}</button></form>{% endif %}{% endunless %}</div>{% endunless %}
  <p data-commerce-error role="alert" class="text-xs text-red-600"></p>
</article>

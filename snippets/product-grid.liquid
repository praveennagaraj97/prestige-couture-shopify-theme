<div class="grid grid-cols-2 gap-3 sm:hidden">{% for product in products %}{% if product.object_type == 'product' or product.object_type == blank %}<div data-motion='{"initial":{"opacity":0,"y":22},"animate":{"opacity":1,"y":0},"transition":{"duration":0.55,"ease":[0.22,1,0.36,1]},"inView":true,"viewport":{"once":true,"amount":0.15}}' style="content-visibility:auto;contain-intrinsic-size:540px">{% render 'product-card', product: product, mode: 'mobile', index: forloop.index0 %}</div>{% endif %}{% endfor %}</div>
<div class="hidden sm:grid {{ desktop_class | default: 'grid-cols-2 gap-4 md:grid-cols-3 md:gap-5 lg:grid-cols-3 2xl:grid-cols-4' }}">{% for product in products %}{% if product.object_type == 'product' or product.object_type == blank %}<div data-motion='{"initial":{"opacity":0,"y":22},"animate":{"opacity":1,"y":0},"transition":{"duration":0.55,"ease":[0.22,1,0.36,1],"delay":{{ forloop.index0 | times: 0.08 | plus: 0.15 }}},"inView":true,"viewport":{"once":true,"amount":0.15}}' style="content-visibility:auto;contain-intrinsic-size:540px">{% render 'product-card', product: product, mode: 'desktop', index: forloop.index0 %}</div>{% endif %}{% endfor %}</div>

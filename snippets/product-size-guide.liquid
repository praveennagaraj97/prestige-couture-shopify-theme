<div data-modal="size-guide" data-modal-variant="bubble" hidden><div data-modal-panel class="flex min-h-0 w-full flex-1 flex-col"><div class="flex items-center justify-between border-b border-strong-coffee/10 bg-white px-5 py-4"><div><h2 class="font-libre-baskerville text-lg text-dark-chocolate leading-tight">{{ section.settings.guide_label }}</h2><p class="text-[11px] uppercase tracking-[0.18em] text-strong-coffee/60">{{ section.settings.fit_label }}</p></div><button type="button" data-close-modal aria-label="{{ section.settings.close_guide_label }}" class="h-9 w-9 text-strong-coffee/70">×</button></div><div class="relative flex border-b border-strong-coffee/10 bg-white"><button type="button" data-guide-tab="chart" class="relative flex-1 px-4 py-3 text-sm font-medium tracking-wide text-rust">{{ section.settings.chart_label }}</button><button type="button" data-guide-tab="measure" class="relative flex-1 px-4 py-3 text-sm font-medium tracking-wide text-strong-coffee/65">{{ section.settings.measure_label }}</button></div><div class="min-h-0 flex-1 overflow-y-auto bg-white-chocolate/30 px-5 py-5"><div data-guide-panel="chart"><div class="mb-4 flex items-center justify-between"><p class="text-xs text-strong-coffee/70">{{ section.settings.measurement_text }}</p><div class="inline-flex items-center rounded-full border border-strong-coffee/15 bg-white p-0.5 text-xs"><button type="button" data-guide-unit="in" aria-pressed="true" class="rounded-full bg-rust text-white px-3 py-1">IN</button><button type="button" data-guide-unit="cm" aria-pressed="false" class="rounded-full px-3 py-1">CM</button></div></div><div class="overflow-hidden rounded-xl bg-white shadow-[0_1px_0_rgba(44,36,26,0.06)]"><div class="grid grid-cols-4 border-b border-strong-coffee/10 bg-rust/5 px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.15em] text-dark-chocolate"><span>{{ section.settings.size_label }}</span><span>{{ section.settings.bust_label }}</span><span>{{ section.settings.waist_label }}</span><span>{{ section.settings.hip_label }}</span></div>{% for block in section.blocks %}{% if block.type == 'size' %}<div {{ block.shopify_attributes }} class="grid grid-cols-4 border-b border-strong-coffee/5 px-4 py-3 text-sm text-strong-coffee last:border-b-0"><span class="font-semibold text-dark-chocolate">{{ block.settings.size }}</span><span data-inches="{{ block.settings.bust }}">{{ block.settings.bust }}″</span><span data-inches="{{ block.settings.waist }}">{{ block.settings.waist }}″</span><span data-inches="{{ block.settings.hip }}">{{ block.settings.hip }}″</span></div>{% endif %}{% endfor %}</div><p class="mt-4 text-[11px] leading-relaxed text-strong-coffee/60">{{ section.settings.chart_note }}</p></div><div data-guide-panel="measure" hidden><div class="mx-auto mb-5 flex h-56 w-full items-center justify-center rounded-xl bg-white"><svg viewBox="0 0 200 220" class="h-full w-auto text-dark-chocolate" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M100 10 C112 10 120 20 120 32 C120 44 112 52 100 52 C88 52 80 44 80 32 C80 20 88 10 100 10 Z M75 60 L125 60 L145 95 L135 110 L125 100 L125 205 L75 205 L75 100 L65 110 L55 95 Z"/><path d="M60 85h80 M70 125h60 M65 160h70" stroke="#b13e10" stroke-dasharray="3 3"/><g fill="#b13e10" stroke="none" font-size="10"><text x="145" y="88">{{ section.settings.bust_label }}</text><text x="145" y="128">{{ section.settings.waist_label }}</text><text x="145" y="163">{{ section.settings.hip_label }}</text></g></svg></div><div class="space-y-3 text-xs leading-relaxed text-strong-coffee/70">{{ section.settings.measure_text }}</div></div></div></div></div>

<div data-modal="product-zoom" data-modal-variant="fullscreen" hidden><div data-modal-panel class="flex h-full w-full flex-col bg-dark-chocolate/95 backdrop-blur-sm"><div class="relative z-10 flex items-center justify-between px-4 py-3 text-white md:px-6"><span data-lightbox-counter class="text-[11px] uppercase tracking-[0.22em] text-white/70"></span><button type="button" data-close-modal aria-label="{{ section.settings.close_zoom_label }}" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white">×</button></div><div class="relative flex-1 select-none overflow-hidden" data-zoom-canvas>{% if product.featured_image %}<img data-zoom-image width="1600" height="2000" src="{{ product.featured_image | image_url: width: 1600 }}" alt="{{ product.title | escape }}" draggable="false" class="absolute inset-0 h-full w-full object-contain">{% endif %}<div class="pointer-events-auto absolute bottom-4 left-1/2 flex -translate-x-1/2 items-center gap-1 rounded-full bg-white/10 p-1 backdrop-blur"><button type="button" data-zoom-step="-0.5" aria-label="{{ section.settings.zoom_out_label }}" class="h-9 w-9 text-xl text-white">−</button><button type="button" data-zoom-reset class="px-3 text-[11px] font-medium uppercase tracking-[0.18em] text-white/90">{{ section.settings.reset_label }}</button><button type="button" data-zoom-step="0.5" aria-label="{{ section.settings.zoom_in_label }}" class="h-9 w-9 text-xl text-white">+</button></div><p class="pointer-events-none absolute bottom-20 left-1/2 -translate-x-1/2 text-center text-[11px] uppercase tracking-[0.18em] text-white/60">{{ section.settings.zoom_hint }}</p></div><div class="flex justify-center"><div class="relative z-10 flex items-center w-fit gap-2 overflow-x-auto no-scrollbar px-4 pb-4 pt-2 md:pb-6">{% for image in product.images %}<button type="button" data-lightbox-thumb="{{ forloop.index0 }}" aria-label="{{ section.settings.view_label }} {{ forloop.index }}" class="relative aspect-3/4 h-16 shrink-0 overflow-hidden rounded-md transition md:h-20 outline-1 outline-white/20">{{ image | image_url: width: 160 | image_tag: class: 'h-full w-full object-cover', loading: 'lazy' }}</button>{% endfor %}</div></div></div></div>

<aside class="flex min-h-0 flex-col rounded-2xl bg-white-chocolate/40 ring-1 ring-strong-coffee/5"><div class="flex shrink-0 items-center justify-between border-b border-strong-coffee/10 px-5 py-4"><h2 class="font-libre-baskerville text-base text-dark-chocolate">{{ section.settings.filters_label }}</h2><a data-collection-link href="{{ collection.url }}?sort_by={{ collection.sort_by | default: 'best-selling' }}" class="text-[11px] uppercase tracking-[0.2em] text-rust">{{ section.settings.clear_label }}</a></div><div class="flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto p-5"><div class="border-b border-strong-coffee/10 pb-4"><span class="mb-2.5 block text-[13px] font-semibold uppercase tracking-[0.16em] text-dark-chocolate">{{ section.settings.price_label }}</span><div class="flex flex-wrap gap-1.5">{% for i in (1..4) %}{% assign label_key = 'price_' | append: i %}{% assign min_key = label_key | append: '_min' %}{% assign max_key = label_key | append: '_max' %}{% assign min = section.settings[min_key] %}{% assign max = section.settings[max_key] %}{% assign min_cents = min | times: 100 %}{% assign max_cents = max | times: 100 %}{% assign bucket_active = false %}{% for filter in collection.filters %}{% if filter.type == 'price_range' and filter.min_value.value == min_cents %}{% if max == 0 %}{% if filter.max_value.value == blank %}{% assign bucket_active = true %}{% endif %}{% elsif filter.max_value.value == max_cents %}{% assign bucket_active = true %}{% endif %}{% endif %}{% endfor %}<button type="button" data-price-min="{{ min }}" data-price-max="{% if max > 0 %}{{ max }}{% endif %}" aria-pressed="{{ bucket_active }}" class="rounded-full border px-3 py-1.5 text-[12px] {% if bucket_active %}border-rust bg-rust text-white{% else %}border-strong-coffee/20 bg-white text-strong-coffee/85 hover:border-rust/50{% endif %}">{{ section.settings[label_key] }}</button>{% endfor %}</div></div>
<noscript><form action="{{ collection.url }}" method="get"><label>{{ section.settings.price_label }}<input type="number" name="filter.v.price.gte" min="0" placeholder="0"><input type="number" name="filter.v.price.lte" min="0" placeholder="1500"></label><button type="submit">{{ section.settings.apply_label }}</button></form></noscript><form data-filter-form action="{{ collection.url }}" method="get"><input type="hidden" name="sort_by" value="{{ collection.sort_by | default: 'best-selling' }}">{% for filter in collection.filters %}{% if filter.type == 'price_range' %}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"><input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}">{% else %}{% assign filter_label = filter.label | downcase %}{% if filter.param_name == 'filter.v.option.size' or filter_label == 'size' %}<details data-size-filter open class="border-b border-strong-coffee/10 pb-4"><summary class="group flex w-full items-center justify-between gap-3 py-2 text-left text-[13px] font-semibold uppercase tracking-[0.16em] text-dark-chocolate">{{ filter.label | escape }}<span class="kw-filter-chevron text-[11px] text-rust">{% render 'icon', name: 'chevron-down' %}</span></summary><ul class="mt-2 flex flex-col gap-1.5 pb-1">{% for value in filter.values %}<li><label class="flex cursor-pointer items-center gap-2.5 rounded-md px-1.5 py-1.5 transition-colors hover:bg-white-chocolate/60"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} class="kw-size-checkbox size-4 shrink-0 rounded-sm border border-strong-coffee/30 bg-white"><span class="flex-1 text-[13px] text-strong-coffee/85">{{ value.label | escape }}</span><span class="text-[11px] text-strong-coffee/50">{{ value.count }}</span></label></li>{% endfor %}</ul></details>{% endif %}{% endif %}{% endfor %}<noscript><button type="submit">{{ section.settings.apply_label }}</button></noscript></form></div></aside>
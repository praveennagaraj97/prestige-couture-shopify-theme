<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="h-full antialiased">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  {%- assign seo_title = page_title | default: shop.name -%}
  {%- assign meta_description = page_description | default: shop.description | default: settings.default_meta_description -%}
  {%- assign social_image = page_image | default: settings.social_sharing_image -%}
  <title>{{ seo_title | escape }}</title>
  <meta name="description" content="{{ meta_description | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {% else %}
    <link rel="icon" type="image/png" href="{{ 'logo.png' | asset_url }}">
  {% endif %}
  <meta property="og:title" content="{{ seo_title | escape }}">
  <meta property="og:description" content="{{ meta_description | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  {% if social_image != blank %}
    <meta property="og:image" content="{{ social_image | image_url: width: 1200 }}">
    <meta name="twitter:image" content="{{ social_image | image_url: width: 1200 }}">
  {% else %}
    <meta property="og:image" content="{{ 'logo.png' | asset_url }}">
    <meta name="twitter:image" content="{{ 'logo.png' | asset_url }}">
  {% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo_title | escape }}">
  <meta name="twitter:description" content="{{ meta_description | escape }}">
  {{ 'fonts.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <script>window.KW={validation:{required:{{ settings.form_required | default: "Please complete this field." | json }},email:{{ settings.form_email | default: "Please enter a valid email address." | json }},invalid:{{ settings.form_invalid | default: "Please check this value." | json }}},root:{{ routes.root_url | json }},accountUrl:{{ routes.account_url | json }},searchUrl:{{ routes.search_url | json }},labels:{previous:{{ settings.previous_label | json }},next:{{ settings.next_label | json }} }};</script>
  <script type="module" src="{{ 'theme.js' | asset_url }}"></script>
</head>
<body class="max-w-400 mx-auto">
  <a class="sr-only focus:not-sr-only focus:fixed focus:top-0 focus:z-100 focus:bg-white focus:p-3" href="#MainContent">{{ settings.skip_label | escape }}</a>
  {% sections 'header-group' %}
  <main id="MainContent" class="text-dark-chocolate" tabindex="-1">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
  {% section 'cart-modal' %}
  <div data-toast role="status" aria-live="polite" hidden class="fixed bottom-20 left-1/2 z-100 max-w-[90vw] -translate-x-1/2 rounded-xl bg-dark-chocolate px-5 py-3 text-sm text-white shadow-xl"></div>
</body>
</html>
